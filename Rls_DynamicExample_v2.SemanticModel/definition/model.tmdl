model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Dim_CostCenter","Fact_Expenses","DynamicRoles","DynamicRoleUsers","DynamicUsers","Dim_Projects","Dim_Country"]

ref table Dim_CostCenter
ref table Fact_Expenses
ref table 'Measure Table'
ref table DynamicRoles
ref table DynamicRoleUsers
ref table DynamicUsers
ref table Dim_Projects
ref table Dim_Country

ref role DynamicRLS

ref cultureInfo en-US

