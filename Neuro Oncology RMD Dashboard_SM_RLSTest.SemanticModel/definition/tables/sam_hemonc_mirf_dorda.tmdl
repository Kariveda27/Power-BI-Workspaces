table sam_hemonc_mirf_dorda
	lineageTag: 024d37a9-f71d-43fe-8893-a49aedfba3e3

	measure 'MIR Submitted Call Count' =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_mirf_dorda[request_number]),
			    FILTER(
			        sam_hemonc_mirf_dorda, NOT(ISBLANK(sam_hemonc_mirf_dorda[request_number])) &&
			        TRIM(sam_hemonc_mirf_dorda[status]) = "Submitted"
			    )
			),0)
		formatString: 0
		lineageTag: 5b9c0799-5fff-49f7-a251-0f52056bea9d

	measure 'MIR Submitted Call %' =
			
			DIVIDE([MIR Submitted Call Count], DISTINCTCOUNT(sam_hemonc_mirf_dorda[request_number]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 85c5c905-4191-4827-9ef3-9d87890e0a4b

	measure 'MIR Cancelled Call Count' =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_mirf_dorda[request_number]),
			    FILTER(
			        sam_hemonc_mirf_dorda, NOT(ISBLANK(sam_hemonc_mirf_dorda[request_number])) &&
			        TRIM(sam_hemonc_mirf_dorda[status]) = "Cancelled"
			    )
			),0)
		formatString: 0
		lineageTag: 44964418-a824-492d-9705-388b37b931a6

	measure 'MIR Cancelled Call %' =
			
			DIVIDE([MIR Cancelled Call Count], DISTINCTCOUNT(sam_hemonc_mirf_dorda[request_number]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: da1e3ff8-5cf5-4abb-8481-24d2cfda4b7d

	measure 'MIR Closed Call Count' =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_mirf_dorda[request_number]),
			    FILTER(
			        sam_hemonc_mirf_dorda, NOT(ISBLANK(sam_hemonc_mirf_dorda[request_number])) &&
			        TRIM(sam_hemonc_mirf_dorda[status]) = "Closed"
			    )
			),0)
		formatString: 0
		lineageTag: fe1395c0-9205-4581-be27-be81bb1c36cf

	measure 'MIR Closed Call %' =
			
			DIVIDE([MIR Closed Call Count], DISTINCTCOUNT(sam_hemonc_mirf_dorda[request_number]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f5a80263-e463-431b-af06-905077d0c2e3

	measure 'MIR Request Submitted Call Count 1' =
			
			CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_mirf_dorda[mirf_case_id]),
			    FILTER(
			        sam_hemonc_mirf_dorda, NOT(ISBLANK(sam_hemonc_mirf_dorda[mirf_case_id])) &&
			        TRIM(sam_hemonc_mirf_dorda[request_for_msl_followup]) = "Yes"
			    )
			)
		formatString: 0
		lineageTag: 000daf3f-5293-4f2e-a410-f268712ecc1f

	measure 'MIR Responded Call %' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT(sam_hemonc_mirf_dorda[mirf_case_id]),
			        FILTER(
			            sam_hemonc_mirf_dorda,
			            TRIM(sam_hemonc_mirf_dorda[request_for_msl_followup]) = "No"
			        )
			    ),
			    DISTINCTCOUNT(sam_hemonc_mirf_dorda[mirf_case_id])
			)
		formatString: 0%;-0%;0%
		lineageTag: 7c732ce1-98b9-465f-af4a-a85a9c0c2bd2

	measure 'MIR Call Count' = ```
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_mirf_dorda[mirf_case_id]),
			    FILTER(
			        sam_hemonc_mirf_dorda, NOT(ISBLANK(sam_hemonc_mirf_dorda[mirf_case_id])) 
			        //&& TRIM(sam_hemonc_mirf_dorda[status]) = "Submitted_vod"
			    )
			),0)
			```
		formatString: 0
		lineageTag: 2121034b-9ec8-4477-91cf-ffda06a162b7

	measure 'Max Date (Mirf)' = MAX(sam_hemonc_mirf_dorda[updatedate])
		formatString: Short Date
		lineageTag: c45a7e07-3548-406f-bbe8-c2b72007cf2b

	measure '% RMD Attention' = ```
			
			DIVIDE(
			    CALCULATE(
			        COUNT(sam_hemonc_mirf_dorda[request_number]),
			        sam_hemonc_mirf_dorda[request_for_msl_follow_up_mvn__c] = "Yes"
			    ),
			    COUNT(sam_hemonc_mirf_dorda[request_number])
			)
			
			```
		formatString: 0%;-0%;0%
		lineageTag: 41460278-9cea-4fa0-a026-4a9065de2d69

	measure 'MIR Open Call Count' =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_mirf_dorda[request_number]),
			    FILTER(
			        sam_hemonc_mirf_dorda, NOT(ISBLANK(sam_hemonc_mirf_dorda[request_number])) &&
			        TRIM(sam_hemonc_mirf_dorda[status]) = "Open"
			    )
			),0)
		formatString: 0
		lineageTag: 4001e5ab-53a2-4c65-8d5f-f2c07470b06b

	measure 'MIR Open Call %' =
			
			DIVIDE([MIR Open Call Count], DISTINCTCOUNT(sam_hemonc_mirf_dorda[request_number]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7d21beef-0f93-49a7-ba71-6468b08ba071

