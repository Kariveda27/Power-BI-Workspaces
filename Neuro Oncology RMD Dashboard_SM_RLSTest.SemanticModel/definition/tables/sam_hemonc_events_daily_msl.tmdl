table sam_hemonc_events_daily_msl
	lineageTag: 1174549e-27e9-433b-b7ad-81d3b71a70e6

	measure Reached =
			
			CALCULATE(DISTINCTCOUNT(sam_hemonc_events_daily_msl[jazzid]))+0
		formatString: 0
		lineageTag: a6619d98-e244-41b5-94ae-8322158902cf

	measure Interactions =
			
			CALCULATE(DISTINCTCOUNT(sam_hemonc_events_daily_msl[callid]))+0
			/*
			    COALESCE(CALCULATE(
			        DISTINCTCOUNT(sam_hemonc_events_daily_msl[callid]),
			        FILTER(
			            sam_hemonc_events_daily_msl,
			            NOT(ISBLANK(sam_hemonc_events_daily_msl[callid]))
			            -- && TRIM(sam_hemonc_mirf_dorda[status]) = "Closed"
			        )
			    ),0
			  )*/
		formatString: 0
		lineageTag: 6c029fc3-3a93-40db-b043-7d29cfb7769e

	measure Frequency =
			
			DIVIDE(
			  [Interactions],
			  [Reached],
			  0
			)
		formatString: 0.0
		lineageTag: 6d773e0c-3cfa-4ebd-819b-6924da03434b

	measure 'Reached 1' =
			
			CALCULATE(DISTINCTCOUNT(sam_hemonc_events_daily_msl[jazzid]))+0
		formatString: 0
		lineageTag: 208bf160-260d-4263-9c21-ec32f0c63ab0

	measure 'Latest Interaction Date' = MAX(sam_hemonc_events_daily_msl[eventdate])
		formatString: Short Date
		lineageTag: 02b95a80-a046-47e1-9820-0de66c8c8a02

	measure 'First Interaction Date' = MIN(sam_hemonc_events_daily_msl[eventdate])
		formatString: Short Date
		lineageTag: 3db01048-068f-451c-af20-b6ed5a522af4

	measure 'Latest Topics Discussed' =
			
			VAR MaxDate = MAX ( sam_hemonc_events_daily_msl[eventdate])
			RETURN
			    CALCULATE (
			        FIRSTNONBLANK ( sam_hemonc_events_daily_msl[specifictopics], 1 ),
			        sam_hemonc_events_daily_msl[eventdate] = MaxDate
			    )
		lineageTag: 4818f07e-dac5-47ed-97c0-13d7e824df87

	measure 'Max Date (MSL)' = ```
			FORMAT(MAX(sam_hemonc_events_daily_msl[updatedate]),"mm/dd/yyyy")
			
			```
		lineageTag: b52b1ba3-0f13-428e-8472-52f43f65ffc3

	measure Measure =
			SUMX(
			    VALUES(sam_hemonc_events_daily_msl[eventdate]),
			    CALCULATE(DISTINCTCOUNT(sam_hemonc_events_daily_msl[jazzid]))
			)
		formatString: 0
		lineageTag: 918f04a9-affa-4944-b28f-021946c5c8ff

