table sam_hemonc_product_metrics
	lineageTag: 884f0e13-d00e-4aa6-b1fe-30928d733078

	measure 'No Of Engagement HCPs' =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_product_metrics[jazzid]),
			    FILTER(
			        sam_hemonc_product_metrics, NOT(ISBLANK(sam_hemonc_product_metrics[jazzid]) &&
			        TRIM(sam_hemonc_product_metrics[jazz_cmrx_sentiment_flag]) = "Limited Awareness"
			    )
			)
			),0)
		formatString: 0
		lineageTag: d0c6c0e0-01c0-4b15-8211-01f2cd19f366

	measure 'Reluctant Engagement HCPs' =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_product_metrics[jazzid]),
			    FILTER(
			        sam_hemonc_product_metrics, NOT(ISBLANK(sam_hemonc_product_metrics[jazzid]) &&
			        TRIM(sam_hemonc_product_metrics[jazz_cmrx_sentiment_flag]) = "Limited Awareness"
			    )
			)),0)
		formatString: 0
		lineageTag: 0a97f495-56ec-4143-be83-f03ccdd952cf

	measure 'Consistent Engagement HCPs' =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_product_metrics[jazzid]),
			    FILTER(
			        sam_hemonc_product_metrics, NOT(ISBLANK(sam_hemonc_product_metrics[jazzid]) &&
			        TRIM(sam_hemonc_product_metrics[jazz_cmrx_sentiment_flag]) = "Limited Awareness"
			    )
			)),0)
		formatString: 0
		lineageTag: aacbbc67-11d7-44b3-981f-6cd5754260f8

	measure 'Frequent Engagement HCPs' =
			
			COALESCE(CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_product_metrics[jazzid]),
			    FILTER(
			        sam_hemonc_product_metrics, NOT(ISBLANK(sam_hemonc_product_metrics[jazzid]) &&
			        TRIM(sam_hemonc_product_metrics[jazz_cmrx_sentiment_flag]) = "Limited Awareness"
			    )
			)),0)
		formatString: 0
		lineageTag: eacfac1b-c61a-4dc4-91d2-6e4da0e41a68

	measure 'Distinct Jazz ID' =
			
			CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_product_metrics[jazzid]),
			    FILTER(
			        sam_hemonc_product_metrics, NOT(ISBLANK(sam_hemonc_product_metrics[jazzid]) --&&
			        //TRIM(sam_hemonc_product_metrics[jazz_cmrx_sentiment_flag]) = "Limited Awareness"
			    )
			))
		formatString: 0
		lineageTag: fa14412a-ebdf-46d4-95c8-8fcae91f885c

	measure 'Max Date' = MAX(sam_hemonc_product_metrics[updatedate])
		formatString: Short Date
		lineageTag: 3f1098e9-0870-49a8-b3cd-2613953d81b6

	measure 'Last Sales Interaction Date' =
			
			VAR MaxSalesDate =
			    CALCULATE(
			        MAX( Date ),
			        FILTER(
			            ALL( sam_hemonc_interactions ),
			            field = "Sales"
			        )
			    )
			RETURN
			    MaxSalesDate
		lineageTag: 91353be5-dd39-497a-99e9-f5025f3ea550

	measure 'Last interaction Date (#MSL Team)' =
			
			CALCULATE(
			  MAX( sam_hemonc_product_metrics[updatedate] ),
			  sam_hemonc_product_metrics[fieldtype] = "MSL"
			)
		formatString: Short Date
		lineageTag: f35c5e54-38ad-4745-83da-ec0237609d31

	measure 'Last interaction Date (#Sales Team)' =
			
			CALCULATE(
			  MAX( sam_hemonc_product_metrics[updatedate] ),
			  sam_hemonc_product_metrics[fieldtype] = "Sales"
			)
		formatString: General Date
		lineageTag: 0d0cb448-498b-4281-be98-cd5ad9fa7dac

	measure '#MSL Interactions (D.JID)' =
			
			CALCULATE(
			    DISTINCTCOUNT(sam_hemonc_product_metrics[jazzid]),
			    FILTER(
			        sam_hemonc_product_metrics, NOT(ISBLANK(sam_hemonc_product_metrics[jazzid]) &&
			        TRIM(sam_hemonc_product_metrics[fieldtype]) = "MSL"
			    )
			))
		formatString: 0
		lineageTag: 25f8b264-1ac3-4abf-b22b-cd8d243d26ee

	measure '# MSL Interactions' = ```
			
			
			    CALCULATE(
			        DISTINCTCOUNT(sam_hemonc_product_metrics[id]),
			        FILTER(
			            sam_hemonc_product_metrics,
			            NOT(ISBLANK(sam_hemonc_product_metrics[id]))
			            && TRIM(sam_hemonc_product_metrics[fieldtype]) = "MSL"
			        )
			    )
			```
		formatString: 0
		lineageTag: cc08f9bd-176b-4d28-802e-799d244ef8fd

	column 'Product & Fieldtype Flag' = ```
			
			sam_hemonc_product_metrics[fieldtype] = "Chimerix MSL" &&
			sam_hemonc_product_metrics[productname] IN { "Dordaviprone", "Disease State Education" }
			
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 167a1d14-6f23-4475-bd4f-88a8ef18841e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

