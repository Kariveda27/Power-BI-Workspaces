	partition sam_hemonc_product_metrics = m
		mode: import
		source = ```
				let
				    // Step 1: Connect to Redshift source
				    Source = Odbc.DataSource("dsn=PowerBI_Redshift_CommercialUS", [HierarchicalNavigation=true]),
				
				    // Step 2: Navigate to database and schema
				    commdw_Database = Source{[Name="commdw",Kind="Database"]}[Data],
				    sam_hemonc_bu_Schema = commdw_Database{[Name="sam_hemonc_bu",Kind="Schema"]}[Data],
				
				    // Step 3: Load the sam_hemonc_product_metrics table
				    sam_hemonc_product_metrics_Table = sam_hemonc_bu_Schema{[Name="sam_hemonc_product_metrics",Kind="Table"]}[Data],
				
				    // Step 4: Apply filters
				    FilteredRows = Table.SelectRows(
				        sam_hemonc_product_metrics_Table,
				        each 
				            List.Contains(
				                {"US DORDA MSL", "US Chimerix MSL"},
				                [fieldtype]
				            ) and
				            List.Contains(
				                {"Disease State Education", "ONC 206", "Dordaviprone", "Pipeline", "MODEYSO"},
				                [productname]
				            ) and
				            [jazz_cmrx_sentiment_flag] <> null and Text.Trim([jazz_cmrx_sentiment_flag]) <> ""
				  
				    )
				
				in
				    FilteredRows
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

