model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["CostCenter","Expenses"]

ref table CostCenter
ref table Expenses

ref role '102 Cost Centers'
ref role '101 Cost Centers'

ref cultureInfo en-US

